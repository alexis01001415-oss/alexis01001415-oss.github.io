# Copia este archivo como .env en la raíz del proyecto.
# La access key de Web3Forms es pública por diseño. No pongas claves privadas aquí.
PUBLIC_WEB3FORMS_ACCESS_KEY=
# Cambia por el dominio HTTPS definitivo, sin barra al final.
PUBLIC_SITE_URL=https://duanor.example
# true mantiene la marca ficticia sin indexar. Cambia a false al personalizar para el cliente real.
PUBLIC_DEMO_MODE=true
